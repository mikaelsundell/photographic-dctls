//
// Cineon exposure from photographic stops with zone-based false color.

// clang-format off
DEFINE_UI_PARAMS(exposure, Exposure, DCTLUI_SLIDER_FLOAT, 0.0f, -8.0f, 8.0f, 0.1f)
DEFINE_UI_PARAMS(ev, Exposure EV, DCTLUI_COMBO_BOX, 3, {EV_3, EV_2, EV_1, EV0, EV1, EV2, EV3}, {EV -3, EV -2, EV -1, EV 0, EV 1, EV 2, EV 3})
DEFINE_UI_PARAMS(adjustdisplay, Adjust for display, DCTLUI_CHECK_BOX, 0)
DEFINE_UI_PARAMS(showcolors, Show colors, DCTLUI_CHECK_BOX, 0)
DEFINE_UI_PARAMS(showlegend, Show legend, DCTLUI_CHECK_BOX, 0)

// clang-format on
#include "PD-Common.h"
#include "PD-Cineon.h"

struct CineonExposureParams
{
    float exposure;
    int ev;
};

__DEVICE__ float
cineonexposure_ev_stops(int ev)
{
    if (ev == EV_3) {
        return -3.0f;
    }
    else if (ev == EV_2) {
        return -2.0f;
    }
    else if (ev == EV_1) {
        return -1.0f;
    }
    else if (ev == EV0) {
        return 0.0f;
    }
    else if (ev == EV1) {
        return 1.0f;
    }
    else if (ev == EV2) {
        return 2.0f;
    }
    else if (ev == EV3) {
        return 3.0f;
    }

    return 0.0f;
}

__DEVICE__ float3
cineonexposure_color(float3 rgb, struct CineonExposureParams params)
{
    struct CineonCurve cv = cineon_curve();
    float evs = cineonexposure_ev_stops(params.ev);
    struct CineonColor colors[cineon_stops];

    // Build Cineon thresholds around 18% gray.
    for (int i = 0; i < cineon_stops; i++) {
        colors[i] = cineon_colors[i];
        float lin = pow_f(2.0f, colors[i].stop + evs + 0.5f) * 0.18f;
        float3 log_rgb = min_f3(CineonCurve_lin_cineon(cv, make_float3(lin, lin, lin)), 1.0f);
        colors[i].stop = log_rgb.x;
    }

    float lum = luma_rec709(rgb);

    for (int i = 0; i < cineon_stops; i++) {
        if (lum <= colors[i].stop || i == cineon_stops - 1) {
            return make_float3(colors[i].r, colors[i].g, colors[i].b);
        }
    }

    return make_float3(0.0f, 0.0f, 0.0f);
}

__DEVICE__ float3 transform(int p_Width, int p_Height, int p_X, int p_Y, float p_R, float p_G, float p_B)
{
    float3 rgb = make_float3(p_R, p_G, p_B);

    struct CineonExposureParams params;
    params.exposure = exposure;
    params.ev = ev;

    // Exposure in linear light.
    rgb = max_f3(lin_cineon(cineon_lin(rgb) * pow_f(2.0f, params.exposure)), 0.0f);

    if (showcolors > 0) {
        rgb = cineonexposure_color(rgb, params);
    }

    if (showlegend > 0) {
        int legendwidth = (int)((float)p_Width * 0.8f);
        int offset = (int)((float)p_Height * 0.02f);
        int barheight = (int)((float)p_Height * 0.05f);
        int startY = p_Height - barheight - offset;
        int startX = (int)((float)p_Width * 0.1f);
        int endX = startX + legendwidth;

        if (p_Y >= startY && p_Y < startY + barheight && p_X >= startX && p_X < endX) {
            int width = legendwidth / cineon_stops;

            if (width > 0) {
                int index = (p_X - startX) / width;

                if (index >= 0 && index < cineon_stops) {
                    return make_float3(cineon_colors[index].r, cineon_colors[index].g, cineon_colors[index].b);
                }
            }
        }
    }

    if (adjustdisplay) {
        rgb = adjust_display(rgb);
    }

    return rgb;
}
