//
// Per-channel black/white point, lift, gain, multiply, offset and gamma grading.

// clang-format off
DEFINE_UI_PARAMS(blackpoint_r, Black Point R, DCTLUI_SLIDER_FLOAT, 0.0f, -1.0f, 1.0f, 0.01f)
DEFINE_UI_PARAMS(blackpoint_g, Black Point G, DCTLUI_SLIDER_FLOAT, 0.0f, -1.0f, 1.0f, 0.01f)
DEFINE_UI_PARAMS(blackpoint_b, Black Point B, DCTLUI_SLIDER_FLOAT, 0.0f, -1.0f, 1.0f, 0.01f)
DEFINE_UI_PARAMS(whitepoint_r, White Point R, DCTLUI_SLIDER_FLOAT, 1.0f, 0.0f, 2.0f, 0.01f)
DEFINE_UI_PARAMS(whitepoint_g, White Point G, DCTLUI_SLIDER_FLOAT, 1.0f, 0.0f, 2.0f, 0.01f)
DEFINE_UI_PARAMS(whitepoint_b, White Point B, DCTLUI_SLIDER_FLOAT, 1.0f, 0.0f, 2.0f, 0.01f)
DEFINE_UI_PARAMS(lift_r, Lift R, DCTLUI_SLIDER_FLOAT, 0.0f, -1.0f, 1.0f, 0.01f)
DEFINE_UI_PARAMS(lift_g, Lift G, DCTLUI_SLIDER_FLOAT, 0.0f, -1.0f, 1.0f, 0.01f)
DEFINE_UI_PARAMS(lift_b, Lift B, DCTLUI_SLIDER_FLOAT, 0.0f, -1.0f, 1.0f, 0.01f)
DEFINE_UI_PARAMS(gain_r, Gain R, DCTLUI_SLIDER_FLOAT, 1.0f, 0.0f, 2.0f, 0.01f)
DEFINE_UI_PARAMS(gain_g, Gain G, DCTLUI_SLIDER_FLOAT, 1.0f, 0.0f, 2.0f, 0.01f)
DEFINE_UI_PARAMS(gain_b, Gain B, DCTLUI_SLIDER_FLOAT, 1.0f, 0.0f, 2.0f, 0.01f)
DEFINE_UI_PARAMS(multiply_r, Multiply R, DCTLUI_SLIDER_FLOAT, 1.0f, 0.0f, 2.0f, 0.01f)
DEFINE_UI_PARAMS(multiply_g, Multiply G, DCTLUI_SLIDER_FLOAT, 1.0f, 0.0f, 2.0f, 0.01f)
DEFINE_UI_PARAMS(multiply_b, Multiply B, DCTLUI_SLIDER_FLOAT, 1.0f, 0.0f, 2.0f, 0.01f)
DEFINE_UI_PARAMS(offset_r, Offset R, DCTLUI_SLIDER_FLOAT, 0.0f, -1.0f, 1.0f, 0.01f)
DEFINE_UI_PARAMS(offset_g, Offset G, DCTLUI_SLIDER_FLOAT, 0.0f, -1.0f, 1.0f, 0.01f)
DEFINE_UI_PARAMS(offset_b, Offset B, DCTLUI_SLIDER_FLOAT, 0.0f, -1.0f, 1.0f, 0.01f)
DEFINE_UI_PARAMS(gamma_r, Gamma R, DCTLUI_SLIDER_FLOAT, 0.0f, -1.0f, 1.0f, 0.01f)
DEFINE_UI_PARAMS(gamma_g, Gamma G, DCTLUI_SLIDER_FLOAT, 0.0f, -1.0f, 1.0f, 0.01f)
DEFINE_UI_PARAMS(gamma_b, Gamma B, DCTLUI_SLIDER_FLOAT, 0.0f, -1.0f, 1.0f, 0.01f)
DEFINE_UI_PARAMS(adjustdisplay, Adjust for display, DCTLUI_CHECK_BOX, 1)

// clang-format on
#include "PD-Common.h"

struct Grade
{
    float3 blackpoint;
    float3 whitepoint;
    float3 lift;
    float3 gain;
    float3 multiply;
    float3 offset;
    float3 gamma;
    float2 gamma_scale;
};

__DEVICE__ float3
grade_apply_scale(float3 rgb, float2 scale)
{
    float3 result;
    result.x = rgb.x < 0.0f ? rgb.x * scale.x : rgb.x * scale.y;
    result.y = rgb.y < 0.0f ? rgb.y * scale.x : rgb.y * scale.y;
    result.z = rgb.z < 0.0f ? rgb.z * scale.x : rgb.z * scale.y;
    return result;
}

__DEVICE__ float
grade_apply_channel(float value, float blackpoint, float whitepoint, float lift, float gain, float multiply, float offset, float gamma)
{
    const float eps = 1e-6f;

    // Preserve range direction while avoiding divide-by-zero.
    float range = whitepoint - blackpoint;
    if (abs_f(range) < eps) {
        range = range < 0.0f ? -eps : eps;
    }

    float scaled = (value - blackpoint) / range;
    float lifted = scaled * multiply * (gain - lift) + lift;
    float final_offset = lifted + offset;
    return pow_f(final_offset, 1.0f + gamma);
}

__DEVICE__ float3
grade_apply(float3 rgb, struct Grade params)
{
    rgb.x = grade_apply_channel(rgb.x, params.blackpoint.x, params.whitepoint.x, params.lift.x, params.gain.x, params.multiply.x, params.offset.x, params.gamma.x);
    rgb.y = grade_apply_channel(rgb.y, params.blackpoint.y, params.whitepoint.y, params.lift.y, params.gain.y, params.multiply.y, params.offset.y, params.gamma.y);
    rgb.z = grade_apply_channel(rgb.z, params.blackpoint.z, params.whitepoint.z, params.lift.z, params.gain.z, params.multiply.z, params.offset.z, params.gamma.z);
    return rgb;
}

__DEVICE__ float3 transform(int p_Width, int p_Height, int p_X, int p_Y, float p_R, float p_G, float p_B)
{
    struct Grade params;
    params.whitepoint = make_float3(whitepoint_r, whitepoint_g, whitepoint_b);
    params.blackpoint = make_float3(blackpoint_r, blackpoint_g, blackpoint_b);
    params.lift = make_float3(lift_r, lift_g, lift_b);
    params.gain = make_float3(gain_r, gain_g, gain_b);
    params.multiply = make_float3(multiply_r, multiply_g, multiply_b);
    params.offset = make_float3(offset_r, offset_g, offset_b);
    params.gamma_scale = make_float2(-5.0f, -0.8f);
    params.gamma = grade_apply_scale(make_float3(gamma_r, gamma_g, gamma_b), params.gamma_scale);

    float3 rgb = grade_apply(make_float3(p_R, p_G, p_B), params);

    if (adjustdisplay) {
        rgb = adjust_display(rgb);
    }

    return rgb;
}
