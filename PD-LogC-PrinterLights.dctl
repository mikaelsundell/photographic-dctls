//
// Printer points and RGB trims in linear light.

// clang-format off
DEFINE_UI_PARAMS(logc, LogC, DCTLUI_COMBO_BOX, 0, {LOGC3, LOGC4}, {LogC3, LogC4})
DEFINE_UI_PARAMS(ei, LogC3 EI, DCTLUI_COMBO_BOX, 7, {EI160, EI200, EI250, EI320, EI400, EI500, EI640, EI800, EI1000, EI1280, EI1600}, {EI 160, EI 200, EI 250, EI 320, EI 400, EI 500, EI 640, EI 800, EI 1000, EI 1280, EI 1600})
DEFINE_UI_PARAMS(cpoints, C points, DCTLUI_SLIDER_FLOAT, 25.0f, 0.0f, 50.0f, 0.1f)
DEFINE_UI_PARAMS(mpoints, M points, DCTLUI_SLIDER_FLOAT, 25.0f, 0.0f, 50.0f, 0.1f)
DEFINE_UI_PARAMS(ypoints, Y points, DCTLUI_SLIDER_FLOAT, 25.0f, 0.0f, 50.0f, 0.1f)
DEFINE_UI_PARAMS(wpoints, W points, DCTLUI_SLIDER_FLOAT, 25.0f, 0.0f, 50.0f, 0.1f)
DEFINE_UI_PARAMS(rtrim, R trim, DCTLUI_SLIDER_FLOAT, 25.0f, 0.0f, 50.0f, 0.1f)
DEFINE_UI_PARAMS(gtrim, G trim, DCTLUI_SLIDER_FLOAT, 25.0f, 0.0f, 50.0f, 0.1f)
DEFINE_UI_PARAMS(btrim, B trim, DCTLUI_SLIDER_FLOAT, 25.0f, 0.0f, 50.0f, 0.1f)
DEFINE_UI_PARAMS(mapprinterlights, Use printer points, DCTLUI_CHECK_BOX, 1)
DEFINE_UI_PARAMS(maptrims, Use trims, DCTLUI_CHECK_BOX, 1)
// clang-format on

#include "PD-Common.h"
#include "PD-LogC.h"

struct PrinterPointsParams
{
    int logc;
    int ei;
    float cpoints;
    float mpoints;
    float ypoints;
    float wpoints;
    float rtrim;
    float gtrim;
    float btrim;
    int mapprinterlights;
    int maptrims;
};

__DEVICE__ inline float
printerpoints_gain(float points_delta)
{
    // 12 points = 1 stop.
    return exp2_f(points_delta / 12.0f);
}

__DEVICE__ float3
printerpoints_apply(float3 rgb, struct PrinterPointsParams params)
{
    float dc = params.cpoints - 25.0f;
    float dm = params.mpoints - 25.0f;
    float dy = params.ypoints - 25.0f;
    float dw = params.wpoints - 25.0f;

    // CMY points act on complementary RGB channels.
    float gw = printerpoints_gain(-dw);
    float gr = gw * printerpoints_gain(-dc);
    float gg = gw * printerpoints_gain(-dm);
    float gb = gw * printerpoints_gain(-dy);

    float3 result = make_float3(rgb.x * gr, rgb.y * gg, rgb.z * gb);

    const float eps = 1e-8f;
    result.x = max_f(result.x, eps);
    result.y = max_f(result.y, eps);
    result.z = max_f(result.z, eps);

    return result;
}

__DEVICE__ float3
printerpoints_trims(float3 rgb, struct PrinterPointsParams params)
{
    float dr = params.rtrim - 25.0f;
    float dg = params.gtrim - 25.0f;
    float db = params.btrim - 25.0f;

    float gr = printerpoints_gain(dr);
    float gg = printerpoints_gain(dg);
    float gb = printerpoints_gain(db);

    float3 result = make_float3(rgb.x * gr, rgb.y * gg, rgb.z * gb);

    const float eps = 1e-8f;
    result.x = max_f(result.x, eps);
    result.y = max_f(result.y, eps);
    result.z = max_f(result.z, eps);

    return result;
}

__DEVICE__ float3 transform(int p_Width, int p_Height, int p_X, int p_Y, float p_R, float p_G, float p_B)
{
    float3 rgb = make_float3(p_R, p_G, p_B);

    struct PrinterPointsParams params;
    params.logc = logc;
    params.ei = ei;
    params.cpoints = cpoints;
    params.mpoints = mpoints;
    params.ypoints = ypoints;
    params.wpoints = wpoints;
    params.rtrim = rtrim;
    params.gtrim = gtrim;
    params.btrim = btrim;
    params.mapprinterlights = mapprinterlights;
    params.maptrims = maptrims;

    if (params.logc == LOGC3) {
        rgb = logC3_lin(rgb, params.ei);
    }
    else {
        rgb = logC4_lin(rgb);
    }

    if (params.mapprinterlights) {
        rgb = printerpoints_apply(rgb, params);
    }

    if (params.maptrims) {
        rgb = printerpoints_trims(rgb, params);
    }

    if (params.logc == LOGC3) {
        rgb = lin_logC3(rgb, params.ei);
    }
    else {
        rgb = lin_logC4(rgb);
    }

    return rgb;
}
