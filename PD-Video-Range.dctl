//
// Convert between legal and full range.

// clang-format off
DEFINE_UI_PARAMS(direction, Direction, DCTLUI_COMBO_BOX, 0, {LEGALFULL, FULLLEGAL}, {Legal to Full, Full to Legal})
DEFINE_UI_PARAMS(bitdepth, Bit depth, DCTLUI_COMBO_BOX, 1, {BIT8, BIT10, BIT12}, {8-bit, 10-bit, 12-bit})
DEFINE_UI_PARAMS(adjustdisplay, Adjust for display, DCTLUI_CHECK_BOX, 0)

// clang-format on
#include "PD-Common.h"

struct RangeParams
{
    int direction;
    int bitdepth;
};

__DEVICE__ float
range_bit_max_value(struct RangeParams params)
{
    switch (params.bitdepth) {
    case BIT8:
        return 255.0f;
    case BIT10:
        return 1023.0f;
    case BIT12:
        return 4095.0f;
    }

    return 1023.0f;
}

__DEVICE__ float
range_legal_min_code(struct RangeParams params)
{
    switch (params.bitdepth) {
    case BIT8:
        return 16.0f;
    case BIT10:
        return 64.0f;
    case BIT12:
        return 256.0f;
    }

    return 64.0f;
}

__DEVICE__ float
range_legal_max_code(struct RangeParams params)
{
    switch (params.bitdepth) {
    case BIT8:
        return 235.0f;
    case BIT10:
        return 940.0f;
    case BIT12:
        return 3760.0f;
    }

    return 940.0f;
}

__DEVICE__ float
range_legal_min_value(struct RangeParams params)
{
    return range_legal_min_code(params) / range_bit_max_value(params);
}

__DEVICE__ float
range_legal_max_value(struct RangeParams params)
{
    return range_legal_max_code(params) / range_bit_max_value(params);
}

__DEVICE__ float
range_full_to_legal_f(float value, struct RangeParams params)
{
    float minLegal = range_legal_min_value(params);
    float maxLegal = range_legal_max_value(params);
    return value * (maxLegal - minLegal) + minLegal;
}

__DEVICE__ float
range_legal_to_full_f(float value, struct RangeParams params)
{
    float minLegal = range_legal_min_value(params);
    float maxLegal = range_legal_max_value(params);
    return (value - minLegal) / (maxLegal - minLegal);
}

__DEVICE__ float3
range_full_to_legal_f3(float3 rgb, struct RangeParams params)
{
    return make_float3(range_full_to_legal_f(rgb.x, params), range_full_to_legal_f(rgb.y, params), range_full_to_legal_f(rgb.z, params));
}

__DEVICE__ float3
range_legal_to_full_f3(float3 rgb, struct RangeParams params)
{
    return make_float3(range_legal_to_full_f(rgb.x, params), range_legal_to_full_f(rgb.y, params), range_legal_to_full_f(rgb.z, params));
}

__DEVICE__ float3 transform(int p_Width, int p_Height, int p_X, int p_Y, float p_R, float p_G, float p_B)
{
    float3 rgb = make_float3(p_R, p_G, p_B);

    struct RangeParams params;
    params.direction = direction;
    params.bitdepth = bitdepth;

    switch (params.direction) {
    case LEGALFULL:
        rgb = range_legal_to_full_f3(rgb, params);
        break;
    case FULLLEGAL:
        rgb = range_full_to_legal_f3(rgb, params);
        break;
    }

    if (adjustdisplay) {
        rgb = adjust_display(rgb);
    }

    return rgb;
}
