//
// Applies a reversible color matrix in LogC3 or linear light.

// clang-format off
DEFINE_UI_PARAMS(ei, LogC3 EI, DCTLUI_COMBO_BOX, 7, {EI160, EI200, EI250, EI320, EI400, EI500, EI640, EI800, EI1000, EI1280, EI1600}, {EI 160, EI 200, EI 250, EI 320, EI 400, EI 500, EI 640, EI 800, EI 1000, EI 1280, EI 1600})
DEFINE_UI_PARAMS(convertlinear, Convert to linear, DCTLUI_CHECK_BOX, 1)
DEFINE_UI_PARAMS(reverse, Reverse, DCTLUI_CHECK_BOX, 0)

// clang-format on
#include "PD-Common.h"
#include "PD-LogC.h"

__DEVICE__ float3 transform(int p_Width, int p_Height, int p_X, int p_Y, float p_R, float p_G, float p_B)
{
    float3 rgb = make_float3(p_R, p_G, p_B);

    if (convertlinear) {
        rgb = logC3_lin(rgb, ei);
    }

    if (reverse) {
        struct Matrix mat = {
            0.806165f, 0.168534f, 0.025301f,
            0.091228f, 0.765221f, 0.143550f,
            0.092241f, 0.251418f, 0.656341f
        };
        rgb = mult_matrix(rgb, mat);
    }
    else {
        struct Matrix mat = {
             1.271103f, -0.284279f,  0.013176f,
            -0.127165f,  1.436429f, -0.309264f,
            -0.129927f, -0.510286f,  1.640214f
        };
        rgb = mult_matrix(rgb, mat);
    }

    if (convertlinear) {
        rgb = lin_logC3(rgb, ei);
    }

    return rgb;
}
